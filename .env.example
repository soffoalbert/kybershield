# Copy to .env before running `make up`.

# --- Postgres ---
POSTGRES_USER=kybershield
POSTGRES_PASSWORD=kybershield
POSTGRES_DB=kybershield
POSTGRES_PORT=5432

# --- Ingestion (TypeScript / Fastify) ---
INGESTION_PORT=3000
# Comma-separated clientId:secret pairs. Clients present the secret as `Authorization: Bearer <secret>`.
# Agent credentials for submitting events to ingestion.
API_KEYS=demo-agent:dev-secret-key,ci-harness:another-dev-secret
BODY_LIMIT_BYTES=524288
REQUEST_TIMEOUT_MS=10000
CONNECTION_TIMEOUT_MS=10000
# Largest accepted `POST /v1/events/batch` array.
MAX_BATCH_SIZE=100
DB_POOL_MAX=10
# Server-side cap on a single query, so a pathological one cannot pin a
# connection past the request that wanted it.
DB_STATEMENT_TIMEOUT_MS=5000

# --- Analyser (Python / FastAPI) ---
ANALYSER_PORT=8001
# New events arrive by LISTEN/NOTIFY from an ingestion trigger, so this is the
# fallback interval: the longest an event can go unanalysed if a notification
# is missed, not the normal detection latency.
POLL_INTERVAL_SECONDS=30
LISTEN_ENABLED=true
NOTIFY_CHANNEL=events_ingested
BATCH_SIZE=200
ALLOWED_DOMAINS=api.openai.com,github.com,pypi.org,registry.npmjs.org

# --- Insights (Python / FastAPI) ---
INSIGHTS_PORT=8002
DEFAULT_WINDOW_HOURS=24
# Page size when a request omits `limit`, and the ceiling `limit` is clamped to.
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
# Entries carried by `top_rules` in an agent summary.
TOP_RULES_LIMIT=5

# --- Shared ---
LOG_LEVEL=info

# Operator credentials for the analyser and insights APIs, same format and
# same `Authorization: Bearer <secret>` presentation as API_KEYS above.
#
# A separate set on purpose: these services expose every finding in the estate
# and can trigger a full re-analysis, so an agent's ingest key must not open
# them. Required by both services at startup; `/healthz` stays unauthenticated
# so orchestrators can still probe it.
OPERATOR_API_KEYS=demo-operator:dev-operator-key

# Used by tooling run outside Docker (seed script, local CLI).
DATABASE_URL=postgres://kybershield:kybershield@localhost:5432/kybershield
INGESTION_URL=http://localhost:3000
SEED_API_KEY=dev-secret-key

# Tests do not use DATABASE_URL. Each suite creates and migrates its own
# database (kybershield_test_ingestion / _analyser / _insights) so a run never
# touches the data you are looking at, and two suites cannot truncate each
# other. Override per suite with TEST_DATABASE_URL if needed.
